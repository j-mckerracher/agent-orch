{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mcao:audit-envelope:v1",
  "title": "mcao.audit-envelope.v1 source record",
  "description": "Source envelope for one session-scoped durable_events row. Members not listed here are unknown extensions: v1 readers ignore them. Cross-field rules that JSON Schema cannot express (user actor identity, day_key from ts and timezone) are enforced by validate_released_v1.py and by audit_envelope.rs.",
  "type": "object",
  "required": [
    "schema",
    "ts",
    "event_id",
    "home_id",
    "seq",
    "prev_hash",
    "timezone",
    "day_key",
    "event",
    "category",
    "outcome",
    "platform",
    "session_id",
    "task_id",
    "agent",
    "actor",
    "repo",
    "pr",
    "commit",
    "user"
  ],
  "properties": {
    "schema": { "const": "mcao.audit-envelope.v1" },
    "ts": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "event_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "home_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "seq": { "type": "integer", "minimum": 0 },
    "prev_hash": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" },
    "timezone": { "type": "string", "minLength": 1 },
    "day_key": { "type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "event": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$" },
    "category": { "enum": ["lifecycle", "delivery", "status", "supervision", "identity"] },
    "outcome": { "enum": ["success", "failure", "rejected", "not_applicable"] },
    "platform": { "const": "mcao" },
    "session_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": ["string", "null"], "minLength": 1 },
    "agent": {
      "type": "object",
      "required": ["role", "harness", "model"],
      "properties": {
        "role": { "enum": ["firstmate", "secondmate", "ship", "scout"] },
        "harness": { "type": "string", "minLength": 1 },
        "model": { "type": ["string", "null"], "minLength": 1 }
      }
    },
    "actor": {
      "type": "object",
      "required": ["type", "id"],
      "properties": {
        "type": { "enum": ["user", "agent", "system"] },
        "id": { "type": "string", "minLength": 1 }
      }
    },
    "repo": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
    "pr": { "type": ["string", "null"], "pattern": "^https://[^ \\n]+$" },
    "commit": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" },
    "user": {
      "type": "object",
      "required": ["id", "identity_source"],
      "properties": {
        "id": { "type": "string", "pattern": "^hmac-sha256:[0-9a-f]{64}$" },
        "identity_source": { "enum": ["github_login", "git_email", "local_account"] }
      }
    }
  },
  "allOf": [
    {
      "if": { "required": ["seq"], "properties": { "seq": { "const": 0 } } },
      "then": { "properties": { "prev_hash": { "type": "null" } } },
      "else": { "properties": { "prev_hash": { "type": "string" } } }
    }
  ]
}
