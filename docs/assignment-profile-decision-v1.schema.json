{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcao.invalid/schemas/assignment-profile-decision-v1.schema.json",
  "title": "Assignment profile decision v1",
  "description": "Closed decision record for the assignment-profile-policy-v1 policy. Structural validation only; evidence truth remains subject to review.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_contract",
    "policy_provenance",
    "change_base",
    "intent",
    "expected_surfaces",
    "unclassified_expected_paths",
    "risk_assessment",
    "policy_self_change",
    "decision",
    "profile_floor",
    "actual_change_coverage",
    "test_assessment",
    "security_assessment",
    "evidence"
  ],
  "properties": {
    "schema_version": { "const": "assignment-profile-decision-v1" },
    "task_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_ref", "sha256"],
      "properties": {
        "task_ref": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^\\S.*$" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "policy_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "source", "sha256", "trusted_by", "trust_anchor_ref"],
      "properties": {
        "version": { "const": "assignment-profile-policy-v1" },
        "source": { "const": "docs/assignment-profile-policy-v1.md" },
        "sha256": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "trusted_by": {
          "enum": ["immutable-task-contract", "trusted-admission-record", "unresolved"]
        },
        "trust_anchor_ref": { "anyOf": [{ "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^\\S.*$" }, { "type": "null" }] }
      }
    },
    "change_base": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "selected_from", "selection_ref", "selected_before_work"],
      "properties": {
        "commit": { "anyOf": [{ "$ref": "#/$defs/commit" }, { "type": "null" }] },
        "selected_from": { "anyOf": [{ "const": "trusted-admission-record" }, { "type": "null" }] },
        "selection_ref": { "anyOf": [{ "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^\\S.*$" }, { "type": "null" }] },
        "selected_before_work": { "anyOf": [{ "const": true }, { "type": "null" }] }
      }
    },
    "intent": { "type": "string", "minLength": 1, "maxLength": 2000, "pattern": "^\\S[\\s\\S]*$" },
    "expected_surfaces": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": { "$ref": "#/$defs/surface" },
      "uniqueItems": true
    },
    "unclassified_expected_paths": {
      "type": "array",
      "maxItems": 128,
      "items": { "$ref": "#/$defs/path" },
      "uniqueItems": true
    },
    "risk_assessment": { "$ref": "#/$defs/riskAssessment" },
    "policy_self_change": { "type": "boolean" },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "profile", "reason_codes"],
      "properties": {
        "status": { "enum": ["provisional", "final", "unresolved"] },
        "profile": {
          "anyOf": [
            { "enum": ["docs-only", "small", "standard", "high-risk"] },
            { "type": "null" }
          ]
        },
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "enum": [
            "ORDINARY_PROSE_ONLY",
            "BOUNDED_LOW_RISK",
            "NONTRIVIAL_BEHAVIOR",
            "CROSS_SURFACE_COUPLING",
            "BEHAVIORAL_MARKDOWN_SURFACE",
            "CONFIGURATION_SURFACE",
            "EXECUTABLE_SURFACE",
            "GENERATED_CODE_SURFACE",
            "AUTHORIZATION_CHANGE",
            "SECURITY_SENSITIVE_CHANGE",
            "DATA_PRIVACY_CHANGE",
            "IRREVERSIBLE_SIDE_EFFECT",
            "SAFETY_CRITICAL_CHANGE",
            "SUPPLY_CHAIN_TRUST_CHANGE",
            "POLICY_SELF_CHANGE",
            "RISK_OR_UNCERTAINTY_ESCALATION",
            "UNKNOWN_SURFACE",
            "INCOMPLETE_DIFF_EVIDENCE",
            "UNTRUSTED_POLICY_PROVENANCE",
            "MISSING_CHANGE_BASE",
            "PROVISIONAL_ASSIGNMENT"
          ] }
        }
      }
    },
    "profile_floor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_profile", "source_ref"],
      "properties": {
        "minimum_profile": {
          "anyOf": [
            { "enum": ["docs-only", "small", "standard", "high-risk"] },
            { "type": "null" }
          ]
        },
        "source_ref": {
          "anyOf": [
            { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^\\S.*$" },
            { "type": "null" }
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "minimum_profile": { "type": "null" } }, "required": ["minimum_profile"] },
          "then": { "properties": { "source_ref": { "type": "null" } } }
        },
        {
          "if": { "properties": { "minimum_profile": { "enum": ["docs-only", "small", "standard", "high-risk"] } }, "required": ["minimum_profile"] },
          "then": { "properties": { "source_ref": { "type": "string" } } }
        }
      ]
    },
    "actual_change_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "changed_surfaces", "unclassified_paths", "diff_ref"],
      "properties": {
        "status": { "enum": ["not-yet-available", "complete", "incomplete", "unknown"] },
        "changed_surfaces": {
          "type": "array",
          "maxItems": 128,
          "items": { "$ref": "#/$defs/surface" },
          "uniqueItems": true
        },
        "unclassified_paths": {
          "type": "array",
          "maxItems": 128,
          "items": { "$ref": "#/$defs/path" },
          "uniqueItems": true
        },
        "diff_ref": {
          "anyOf": [
            { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^\\S.*$" },
            { "type": "null" }
          ]
        }
      }
    },
    "test_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["functional_tests_required", "rationale", "evidence_ref"],
      "properties": {
        "functional_tests_required": { "type": "boolean" },
        "rationale": { "type": "string", "minLength": 1, "maxLength": 1200, "pattern": "^\\S[\\s\\S]*$" },
        "evidence_ref": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^\\S.*$" }
      }
    },
    "security_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "rationale", "evidence_ref"],
      "properties": {
        "status": { "enum": ["planned", "satisfied", "not-applicable"] },
        "rationale": { "type": "string", "minLength": 1, "maxLength": 1200, "pattern": "^\\S[\\s\\S]*$" },
        "evidence_ref": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^\\S.*$" }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 7,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/evidence" },
      "uniqueItems": true
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind", "rationale"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "kind": { "enum": [
          "ordinary_prose",
          "behavioral_markdown",
          "configuration",
          "executable",
          "executable_example",
          "generated_code",
          "source_code",
          "authorization_policy",
          "security_sensitive",
          "data_migration",
          "policy_definition",
          "other"
        ] },
        "rationale": { "type": "string", "minLength": 1, "maxLength": 800, "pattern": "^\\S[\\s\\S]*$" }
      }
    },
    "riskAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "uncertainty", "factors", "rationale"],
      "properties": {
        "level": { "enum": ["low", "moderate", "high", "critical"] },
        "uncertainty": { "enum": ["low", "moderate", "high"] },
        "factors": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "enum": [
            "authorization_or_privilege_change",
            "authentication_or_security_boundary",
            "sensitive_data_or_privacy",
            "irreversible_or_external_side_effect",
            "safety_critical",
            "supply_chain_or_execution_trust",
            "policy_or_trust_anchor_change",
            "cross_surface_coupling"
          ] }
        },
        "rationale": { "type": "string", "minLength": 1, "maxLength": 1600, "pattern": "^\\S[\\s\\S]*$" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ref", "detail"],
      "properties": {
        "kind": { "enum": [
          "task-contract",
          "policy-source",
          "change-base",
          "intent-surface-inventory",
          "risk-assessment",
          "functional-test-assessment",
          "security-assessment",
          "diff-coverage",
          "functional-test-results",
          "security-check-results",
          "docs-content-review",
          "configuration-validation",
          "executable-validation",
          "generation-provenance",
          "behavioral-content-review",
          "policy-integrity",
          "trusted-prechange-policy",
          "unknown-surface",
          "incomplete-diff",
          "prior-decision"
        ] },
        "ref": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^\\S.*$" },
        "detail": { "type": "string", "minLength": 1, "maxLength": 800, "pattern": "^\\S[\\s\\S]*$" }
      }
    }
  },
  "allOf": [
    {
      "properties": {
        "evidence": {
          "allOf": [
            { "contains": { "properties": { "kind": { "const": "task-contract" } }, "required": ["kind"] } },
            { "contains": { "properties": { "kind": { "const": "policy-source" } }, "required": ["kind"] } },
            { "contains": { "properties": { "kind": { "const": "change-base" } }, "required": ["kind"] } },
            { "contains": { "properties": { "kind": { "const": "intent-surface-inventory" } }, "required": ["kind"] } },
            { "contains": { "properties": { "kind": { "const": "risk-assessment" } }, "required": ["kind"] } },
            { "contains": { "properties": { "kind": { "const": "functional-test-assessment" } }, "required": ["kind"] } },
            { "contains": { "properties": { "kind": { "const": "security-assessment" } }, "required": ["kind"] }
            }
          ]
        }
      }
    },
    {
      "if": { "properties": { "decision": { "properties": { "status": { "const": "provisional" } } } }, "required": ["decision"] },
      "then": {
        "properties": {
          "decision": { "properties": { "profile": { "enum": ["docs-only", "small", "standard", "high-risk"] }, "reason_codes": { "contains": { "const": "PROVISIONAL_ASSIGNMENT" } } } },
          "unclassified_expected_paths": { "maxItems": 0 },
          "actual_change_coverage": {
            "properties": {
              "status": { "const": "not-yet-available" },
              "changed_surfaces": { "maxItems": 0 },
              "unclassified_paths": { "maxItems": 0 },
              "diff_ref": { "type": "null" }
            }
          },
          "security_assessment": { "properties": { "status": { "const": "planned" } } },
          "evidence": { "not": { "contains": { "properties": { "kind": { "const": "functional-test-results" } }, "required": ["kind"] } } }
        },
        "allOf": [
          {
            "if": { "properties": { "decision": { "properties": { "profile": { "enum": ["small", "standard", "high-risk"] } } } } },
            "then": { "properties": { "test_assessment": { "properties": { "functional_tests_required": { "const": true } } } } }
          }
        ]
      }
    },
    {
      "if": { "properties": { "decision": { "properties": { "status": { "const": "final" } } } }, "required": ["decision"] },
      "then": {
        "properties": {
          "decision": {
            "properties": {
              "profile": { "enum": ["docs-only", "small", "standard", "high-risk"] },
              "reason_codes": { "not": { "contains": { "const": "PROVISIONAL_ASSIGNMENT" } } }
            }
          },
          "policy_provenance": { "properties": { "trusted_by": { "enum": ["immutable-task-contract", "trusted-admission-record"] } } },
          "unclassified_expected_paths": { "maxItems": 0 },
          "actual_change_coverage": {
            "properties": {
              "status": { "const": "complete" },
              "changed_surfaces": { "minItems": 1 },
              "unclassified_paths": { "maxItems": 0 },
              "diff_ref": { "type": "string", "minLength": 1 }
            }
          },
          "security_assessment": { "properties": { "status": { "enum": ["satisfied", "not-applicable"] } } }
        },
        "allOf": [
          {
            "if": { "properties": { "decision": { "properties": { "profile": { "enum": ["small", "standard", "high-risk"] } } } } },
            "then": { "properties": { "test_assessment": { "properties": { "functional_tests_required": { "const": true } } } } }
          }
        ]
      }
    },
    {
      "if": { "properties": { "decision": { "properties": { "status": { "const": "unresolved" } } } }, "required": ["decision"] },
      "then": {
        "properties": {
          "decision": {
            "properties": {
              "profile": { "type": "null" },
              "reason_codes": {
                "anyOf": [
                  { "contains": { "const": "UNKNOWN_SURFACE" } },
                  { "contains": { "const": "INCOMPLETE_DIFF_EVIDENCE" } },
                  { "contains": { "const": "UNTRUSTED_POLICY_PROVENANCE" } },
                  { "contains": { "const": "MISSING_CHANGE_BASE" } },
                  { "contains": { "const": "POLICY_SELF_CHANGE" } }
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "actual_change_coverage": { "properties": { "status": { "enum": ["incomplete", "unknown"] } } } }, "required": ["actual_change_coverage"] },
      "then": { "properties": { "decision": { "properties": { "status": { "const": "unresolved" }, "profile": { "type": "null" } } } } }
    },
    {
      "if": { "properties": { "unclassified_expected_paths": { "minItems": 1 } }, "required": ["unclassified_expected_paths"] },
      "then": { "properties": { "decision": { "properties": { "status": { "const": "unresolved" }, "profile": { "type": "null" }, "reason_codes": { "contains": { "const": "UNKNOWN_SURFACE" } } } } } }
    },
    {
      "if": { "properties": { "actual_change_coverage": { "properties": { "unclassified_paths": { "minItems": 1 } } } }, "required": ["actual_change_coverage"] },
      "then": { "properties": { "decision": { "properties": { "status": { "const": "unresolved" }, "profile": { "type": "null" }, "reason_codes": { "contains": { "const": "UNKNOWN_SURFACE" } } } } } }
    },
    {
      "if": { "properties": { "policy_provenance": { "properties": { "trusted_by": { "const": "unresolved" } } } }, "required": ["policy_provenance"] },
      "then": { "properties": { "decision": { "properties": { "status": { "const": "unresolved" }, "profile": { "type": "null" }, "reason_codes": { "contains": { "const": "UNTRUSTED_POLICY_PROVENANCE" } } } } } }
    },
    {
      "if": { "properties": { "decision": { "properties": { "profile": { "const": "docs-only" } } } }, "required": ["decision"] },
      "then": {
        "properties": {
          "decision": { "properties": { "reason_codes": { "contains": { "const": "ORDINARY_PROSE_ONLY" } } } },
          "risk_assessment": { "properties": { "level": { "const": "low" }, "uncertainty": { "const": "low" } } },
          "test_assessment": { "properties": { "functional_tests_required": { "const": false } } },
          "expected_surfaces": { "items": { "properties": { "kind": { "const": "ordinary_prose" } } } },
          "actual_change_coverage": {
            "properties": {
              "changed_surfaces": { "items": { "properties": { "kind": { "const": "ordinary_prose" } } } },
              "unclassified_paths": { "maxItems": 0 }
            }
          }
        },
        "allOf": [
          { "if": { "properties": { "decision": { "properties": { "status": { "const": "final" } } } } }, "then": { "properties": { "evidence": { "contains": { "properties": { "kind": { "const": "docs-content-review" } }, "required": ["kind"] } } } } }
        ]
      }
    },
    {
      "if": { "properties": { "risk_assessment": { "properties": { "level": { "enum": ["high", "critical"] } } } }, "required": ["risk_assessment"] },
      "then": { "properties": { "decision": { "properties": { "profile": { "anyOf": [{ "const": "high-risk" }, { "type": "null" }] } } } } }
    },
    {
      "if": { "properties": { "risk_assessment": { "properties": { "uncertainty": { "const": "high" } } } }, "required": ["risk_assessment"] },
      "then": { "properties": { "decision": { "properties": { "profile": { "anyOf": [{ "const": "high-risk" }, { "type": "null" }] } } } } }
    },
    {
      "if": { "properties": { "risk_assessment": { "properties": { "level": { "const": "moderate" } } } }, "required": ["risk_assessment"] },
      "then": { "properties": { "decision": { "properties": { "profile": { "anyOf": [{ "enum": ["standard", "high-risk"] }, { "type": "null" }] } } } } }
    },
    {
      "if": { "properties": { "risk_assessment": { "properties": { "uncertainty": { "const": "moderate" } } } }, "required": ["risk_assessment"] },
      "then": { "properties": { "decision": { "properties": { "profile": { "anyOf": [{ "enum": ["standard", "high-risk"] }, { "type": "null" }] } } } } }
    },
    {
      "if": { "properties": { "risk_assessment": { "properties": { "factors": { "contains": { "enum": ["authorization_or_privilege_change", "authentication_or_security_boundary", "sensitive_data_or_privacy", "irreversible_or_external_side_effect", "safety_critical", "supply_chain_or_execution_trust", "policy_or_trust_anchor_change"] } } } } }, "required": ["risk_assessment"] },
      "then": { "properties": { "decision": { "properties": { "profile": { "anyOf": [{ "const": "high-risk" }, { "type": "null" }] }, "reason_codes": { "contains": { "const": "RISK_OR_UNCERTAINTY_ESCALATION" } } } } } }
    },
    {
      "if": { "properties": { "policy_self_change": { "const": true } }, "required": ["policy_self_change"] },
      "then": {
        "properties": {
          "decision": { "properties": { "profile": { "anyOf": [{ "const": "high-risk" }, { "type": "null" }] }, "reason_codes": { "contains": { "const": "POLICY_SELF_CHANGE" } } } }
        },
        "allOf": [
          {
            "if": { "properties": { "decision": { "properties": { "status": { "enum": ["provisional", "final"] } } } }, "required": ["decision"] },
            "then": { "properties": { "evidence": { "allOf": [
              { "contains": { "properties": { "kind": { "const": "trusted-prechange-policy" } }, "required": ["kind"] } },
              { "contains": { "properties": { "kind": { "const": "policy-integrity" } }, "required": ["kind"] } }
            ] } } }
          }
        ]
      }
    },
    {
      "if": { "anyOf": [
        { "properties": { "expected_surfaces": { "contains": { "properties": { "kind": { "const": "policy_definition" } }, "required": ["kind"] } } }, "required": ["expected_surfaces"] },
        { "properties": { "actual_change_coverage": { "properties": { "changed_surfaces": { "contains": { "properties": { "kind": { "const": "policy_definition" } }, "required": ["kind"] } } } } }, "required": ["actual_change_coverage"] }
      ] },
      "then": { "properties": { "policy_self_change": { "const": true }, "decision": { "properties": { "profile": { "anyOf": [{ "const": "high-risk" }, { "type": "null" }] }, "reason_codes": { "contains": { "const": "POLICY_SELF_CHANGE" } } } } } }
    },
    {
      "if": { "anyOf": [
        { "properties": { "expected_surfaces": { "contains": { "properties": { "kind": { "const": "security_sensitive" } }, "required": ["kind"] } } }, "required": ["expected_surfaces"] },
        { "properties": { "actual_change_coverage": { "properties": { "changed_surfaces": { "contains": { "properties": { "kind": { "const": "security_sensitive" } }, "required": ["kind"] } } } } }, "required": ["actual_change_coverage"] }
      ] },
      "then": { "properties": { "decision": { "properties": { "profile": { "anyOf": [{ "const": "high-risk" }, { "type": "null" }] }, "reason_codes": { "contains": { "const": "SECURITY_SENSITIVE_CHANGE" } } } } } }
    },
    {
      "if": { "properties": { "profile_floor": { "properties": { "minimum_profile": { "const": "small" } } } }, "required": ["profile_floor"] },
      "then": { "properties": { "decision": { "properties": { "profile": { "anyOf": [{ "enum": ["small", "standard", "high-risk"] }, { "type": "null" }] } } }, "evidence": { "contains": { "properties": { "kind": { "const": "prior-decision" } }, "required": ["kind"] } } } }
    },
    {
      "if": { "properties": { "profile_floor": { "properties": { "minimum_profile": { "const": "standard" } } } }, "required": ["profile_floor"] },
      "then": { "properties": { "decision": { "properties": { "profile": { "anyOf": [{ "enum": ["standard", "high-risk"] }, { "type": "null" }] } } }, "evidence": { "contains": { "properties": { "kind": { "const": "prior-decision" } }, "required": ["kind"] } } } }
    },
    {
      "if": { "properties": { "profile_floor": { "properties": { "minimum_profile": { "const": "high-risk" } } } }, "required": ["profile_floor"] },
      "then": { "properties": { "decision": { "properties": { "profile": { "anyOf": [{ "const": "high-risk" }, { "type": "null" }] } } }, "evidence": { "contains": { "properties": { "kind": { "const": "prior-decision" } }, "required": ["kind"] } } } }
    },
    {
      "if": { "properties": { "profile_floor": { "properties": { "minimum_profile": { "const": "docs-only" } } } }, "required": ["profile_floor"] },
      "then": { "properties": { "evidence": { "contains": { "properties": { "kind": { "const": "prior-decision" } }, "required": ["kind"] } } } }
    },
    {
      "if": { "properties": { "expected_surfaces": { "contains": { "properties": { "kind": { "const": "behavioral_markdown" } }, "required": ["kind"] } } } },
      "then": { "properties": { "decision": { "properties": { "profile": { "not": { "const": "docs-only" } }, "reason_codes": { "contains": { "const": "BEHAVIORAL_MARKDOWN_SURFACE" } } } }, "evidence": { "contains": { "properties": { "kind": { "const": "behavioral-content-review" } }, "required": ["kind"] } } } }
    },
    {
      "if": { "properties": { "actual_change_coverage": { "properties": { "changed_surfaces": { "contains": { "properties": { "kind": { "const": "behavioral_markdown" } }, "required": ["kind"] } } } } } },
