# Files that tools regenerate during a build must be LF in the working tree on
# every platform. Under Windows `core.autocrlf=true` a CRLF checkout of these
# files is rewritten by the generator and the tree is left dirty after a build.
apps/desktop/src-tauri/permissions/autogenerated/*.toml text eol=lf
Cargo.lock text eol=lf
apps/desktop/src-tauri/Cargo.lock text eol=lf
apps/desktop/package-lock.json text eol=lf
# Real tool output kept as a parser fixture; the parser tests add CRLF themselves.
scripts/ci/fixtures/*.txt text eol=lf
