{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bootstrap-sha": "d0a7f6659eaa298ccc3edfea6ed454d3ad0e529d",
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": true,
  "draft": true,
  "include-component-in-tag": false,
  "include-v-in-tag": true,
  "changelog-path": "docs/changelog.md",
  "pull-request-title-pattern": "chore(release): DPES-1106 - Release ${version}",
  "changelog-sections": [
    { "type": "feat", "section": "Features" },
    { "type": "fix", "section": "Bug Fixes" },
    { "type": "update", "section": "Updates" },
    { "type": "upgrade", "section": "Upgrades" },
    { "type": "perf", "section": "Performance" },
    { "type": "refactor", "section": "Refactoring" },
    { "type": "docs", "section": "Documentation" },
    { "type": "test", "section": "Tests" },
    { "type": "build", "section": "Build" },
    { "type": "ci", "section": "CI" },
    { "type": "revert", "section": "Reverts" },
    { "type": "style", "section": "Style", "hidden": true },
    { "type": "chore", "section": "Chores", "hidden": true }
  ],
  "packages": {
    ".": {
      "release-type": "simple",
      "extra-files": [
        { "type": "toml", "path": "Cargo.toml", "jsonpath": "$.workspace.package.version" },
        { "type": "toml", "path": "Cargo.lock", "jsonpath": "$.package[?(@.source == undefined)].version" },
        { "type": "toml", "path": "apps/desktop/src-tauri/Cargo.toml", "jsonpath": "$.package.version" },
        { "type": "toml", "path": "apps/desktop/src-tauri/Cargo.lock", "jsonpath": "$.package[?(@.source == undefined)].version" },
        { "type": "json", "path": "apps/desktop/src-tauri/tauri.conf.json", "jsonpath": "$.version" },
        { "type": "json", "path": "apps/desktop/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "apps/desktop/package-lock.json", "jsonpath": "$.version" },
        { "type": "json", "path": "apps/desktop/package-lock.json", "jsonpath": "$.packages[''].version" }
      ]
    }
  }
}
